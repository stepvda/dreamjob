# ---------------------------------------------------------------------------
# Dream Job - environment configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DREAMJOB_ENV=development
DREAMJOB_HOST=127.0.0.1
DREAMJOB_PORT=8000
DREAMJOB_DATA_DIR=data
DREAMJOB_DB_PATH=data/dreamjob.db

# Master key for encryption at rest (NFR-201). Generate with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
DREAMJOB_MASTER_KEY=

# Secret used to sign session tokens (NFR-202)
DREAMJOB_SESSION_SECRET=

# --- LLM (CR-409, NFR-306: OpenAI-compatible, provider-agnostic) ------------
DREAMJOB_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DREAMJOB_LLM_MODEL_CHEAP=deepseek-chat
DREAMJOB_LLM_MODEL_STRONG=deepseek-reasoner

# Optional local model for privacy-sensitive steps (NFR-306, CR-410).
# Any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio).
DREAMJOB_LOCAL_LLM_BASE_URL=
DREAMJOB_LOCAL_LLM_MODEL=
DREAMJOB_LOCAL_LLM_API_KEY=not-needed
# Route these task groups to the local model: profile,cv,motivation
DREAMJOB_LOCAL_LLM_TASKS=

# Per-campaign token budget (NFR-104)
DREAMJOB_DEFAULT_TOKEN_BUDGET=2000000
DREAMJOB_LLM_COST_PER_1M_INPUT_EUR=0.25
DREAMJOB_LLM_COST_PER_1M_OUTPUT_EUR=1.00

# --- Email dispatch (FR-325). Two backends: gmail_oauth | resend ------------
DREAMJOB_MAIL_BACKEND=resend
DREAMJOB_MAIL_FROM=stephane@stepvda.com
DREAMJOB_MAIL_FROM_NAME=Stephane van der Aa

# Resend (https://resend.com) - API key added later by the user
RESEND_API_KEY=

# Gmail OAuth (NFR-204: scoped to send + read-bounce only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/api/mail/gmail/callback

# IMAP polling for bounce/reply detection (FR-326)
DREAMJOB_IMAP_HOST=imap.gmail.com
DREAMJOB_IMAP_PORT=993

# --- Sending guard rails (FR-325, RK-05) -----------------------------------
DREAMJOB_SEND_DAILY_CAP=25
DREAMJOB_SEND_MIN_INTERVAL_SECONDS=90
DREAMJOB_SEND_WINDOW_START=08:30
DREAMJOB_SEND_WINDOW_END=17:30

# --- Egress layer (FR-182, IR-102) -----------------------------------------
DREAMJOB_USER_AGENT=DreamJobBot/0.1 (+https://stepvda.net/dreamjob; contact stephane@stepvda.com)
DREAMJOB_HTTP_CACHE_TTL_SECONDS=86400
DREAMJOB_PER_DOMAIN_RPS=0.5
DREAMJOB_HTTP_MAX_CONCURRENCY=20
DREAMJOB_RESPECT_ROBOTS=true

# --- Browser automation (FR-201, section 3.5.2) ----------------------------
DREAMJOB_CDP_URL=http://127.0.0.1:9222
DREAMJOB_BROWSER_PROFILE_DIR=.chrome-profile
DREAMJOB_BROWSER_MIN_DELAY_MS=2500
DREAMJOB_BROWSER_MAX_DELAY_MS=6000

# --- Geocoding (FR-144) ----------------------------------------------------
DREAMJOB_GEOCODER_URL=https://nominatim.openstreetmap.org

# --- Google Calendar (FR-423) ----------------------------------------------
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
